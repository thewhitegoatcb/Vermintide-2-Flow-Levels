            <TR>
                <TD COLSPAN="2" BGCOLOR="#FAFAFA">
                    <FONT FACE="Consolas"><BR ALIGN="LEFT"/>local function flow_callback_destroy_actor( params )<BR ALIGN="LEFT"/>    local unit = params.unit<BR ALIGN="LEFT"/>    assert( unit, &quot;Destroy Actor flow node is missing unit&quot; )<BR ALIGN="LEFT"/>    local actor = params.actor_name<BR ALIGN="LEFT"/>    if Unit.actor(unit, actor) ~= nil then<BR ALIGN="LEFT"/>        Unit.destroy_actor( unit, actor )<BR ALIGN="LEFT"/>    end<BR ALIGN="LEFT"/>end<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>return flow_callback_destroy_actor<BR ALIGN="LEFT"/>        <BR ALIGN="LEFT"/></FONT>
                </TD>
            </TR>
