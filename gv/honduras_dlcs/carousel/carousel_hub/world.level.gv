                    <FONT FACE="Consolas"><B>↓function[0]([]u8)↓</B></FONT>
                </TD>
            </TR>
            <TR>
                <TD COLSPAN="2" BGCOLOR="#FAFAFA">
                    <FONT FACE="Consolas"><BR ALIGN="LEFT"/>local function flow_callback_trigger_event( params )<BR ALIGN="LEFT"/>    local unit = params.unit<BR ALIGN="LEFT"/>    if Unit.alive(unit) then<BR ALIGN="LEFT"/>        Unit.flow_event(params.unit, params.event )<BR ALIGN="LEFT"/>    else<BR ALIGN="LEFT"/>        --Application.warning(&quot;Trying to trigger unit flow event %q for destroyed unit.&quot;, params.event)<BR ALIGN="LEFT"/>    end<BR ALIGN="LEFT"/>end<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>return flow_callback_trigger_event<BR ALIGN="LEFT"/>        <BR ALIGN="LEFT"/></FONT>
                </TD>
            </TR>
            <TR>
                <TD COLSPAN="2" BGCOLOR="#E0E0E0" ALIGN="CENTER">
                    <FONT FACE="Consolas" POINT-SIZE="9"><B>DYNAMIC DATA</B></FONT>
                </TD>
            </TR>

