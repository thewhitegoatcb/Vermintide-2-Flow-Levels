                    <FONT FACE="Consolas" POINT-SIZE="10"><B>unit(unit)1994:</B></FONT>
                </TD>
                <TD>[runtime]</TD>
            </TR>
            <TR>
                <TD COLSPAN="2" BGCOLOR="#E0E0E0" ALIGN="CENTER">
                    <FONT FACE="Consolas" POINT-SIZE="9"><B>↓EVENTS↓</B></FONT>
                </TD>
            </TR>
            <TR>
                <TD PORT="in_function[0]" BGCOLOR="#FFF59D" ALIGN="LEFT">
                    <FONT POINT-SIZE="10"><B>in_function[0]</B></FONT>
