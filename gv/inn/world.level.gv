    CUSTOM_SCRIPT_NODE_411 [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF" COLOR="#37474F">
            <TR>
                <TD COLSPAN="2" BGCOLOR="#37474F">
                    <FONT COLOR="white"><B>411:CUSTOM_SCRIPT_NODE</B></FONT>
                </TD>
            </TR>
            <TR>
                <TD COLSPAN="2" BGCOLOR="#E0E0E0">
                    <FONT FACE="Consolas"><B>Static Data:</B></FONT>
                </TD>
            </TR>
            <TR>
                <TD BGCOLOR="#E0E0E0" ALIGN="LEFT">
                    <FONT FACE="Consolas"><B>ignore_unassigned(Bool):</B></FONT>
                </TD>
                <TD BGCOLOR="#FAFAFA" ALIGN="LEFT">
                    <FONT FACE="Consolas">false</FONT>
                </TD>
            </TR>
            <TR>
                <TD COLSPAN="2" BGCOLOR="#E0E0E0">
                    <FONT FACE="Consolas"><B>↓function[0]([]u8)↓</B></FONT>
                </TD>
            </TR>
            <TR>
                <TD COLSPAN="2" BGCOLOR="#FAFAFA">
                    <FONT FACE="Consolas"><BR ALIGN="LEFT"/>local function split(text, sep)<BR ALIGN="LEFT"/>    sep = sep or &quot;\n&quot;<BR ALIGN="LEFT"/>    local lines = {}<BR ALIGN="LEFT"/>    local pos = 1<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>    while true do<BR ALIGN="LEFT"/>        local b,e = text:find(sep, pos)<BR ALIGN="LEFT"/>        if not b then table.insert(lines, text:sub(pos)) break end<BR ALIGN="LEFT"/>        table.insert(lines, text:sub(pos, b-1))<BR ALIGN="LEFT"/>        pos = e + 1<BR ALIGN="LEFT"/>    end<BR ALIGN="LEFT"/>    <BR ALIGN="LEFT"/>    return lines<BR ALIGN="LEFT"/>end<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>local function flow_set_script_data(params)<BR ALIGN="LEFT"/>    local output_value<BR ALIGN="LEFT"/>    local args = {}<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>    if params.table then<BR ALIGN="LEFT"/>        args = split(params.table,&quot;/&quot;)<BR ALIGN="LEFT"/>    end<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>    for k,v in ipairs(args) do<BR ALIGN="LEFT"/>        if tonumber(v) ~= nil then<BR ALIGN="LEFT"/>                        args[k] = tonumber(v)<BR ALIGN="LEFT"/>        end<BR ALIGN="LEFT"/>    end<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>    local scriptdata = params.scriptdata<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>    if tonumber(scriptdata) ~= nil then<BR ALIGN="LEFT"/>                    scriptdata = tonumber(scriptdata)<BR ALIGN="LEFT"/>    end<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>    table.insert(args,scriptdata)<BR ALIGN="LEFT"/>    table.insert(args,params.value)<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>    Unit.set_data(params.unit, unpack(args))<BR ALIGN="LEFT"/>    <BR ALIGN="LEFT"/>    local returns = { value=output_value }<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>    return<BR ALIGN="LEFT"/>end<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>return flow_set_script_data<BR ALIGN="LEFT"/>        <BR ALIGN="LEFT"/></FONT>
                </TD>
            </TR>
            <TR>
                <TD COLSPAN="2" BGCOLOR="#E0E0E0" ALIGN="CENTER">
                    <FONT FACE="Consolas" POINT-SIZE="9"><B>DYNAMIC DATA</B></FONT>
                </TD>
            </TR>

            <TR>
                <TD PORT="unit" BGCOLOR="#C8E6C9" ALIGN="LEFT">
                    <FONT FACE="Consolas" POINT-SIZE="10"><B>unit(unit)23D8:</B></FONT>
