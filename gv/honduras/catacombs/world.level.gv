                <TD COLSPAN="2" BGCOLOR="#FAFAFA">
                    <FONT FACE="Consolas"><BR ALIGN="LEFT"/>local function flow_callback_is_server()<BR ALIGN="LEFT"/>    local returns<BR ALIGN="LEFT"/>    <BR ALIGN="LEFT"/>    if Managers.account:leaving_game() then<BR ALIGN="LEFT"/>        returns = { yes=false , no=false }<BR ALIGN="LEFT"/>    else<BR ALIGN="LEFT"/>        local is_server = Managers.state.network.is_server<BR ALIGN="LEFT"/>        returns = { yes=is_server , no=not is_server }<BR ALIGN="LEFT"/>    end<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>    return returns<BR ALIGN="LEFT"/>end<BR ALIGN="LEFT"/>return flow_callback_is_server<BR ALIGN="LEFT"/>        <BR ALIGN="LEFT"/></FONT>
                </TD>
            </TR>
